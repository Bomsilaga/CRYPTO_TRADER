# ── Bybit credentials (server-side; never exposed to the browser) ─────────────
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret
BYBIT_TESTNET=false
# Optional reverse proxy for regions where api.bybit.com is CloudFront-blocked
# BYBIT_PROXY_URL=https://your-proxy.example.com

# ── Execution security (Phase 1) ─────────────────────────────────────────────
# LIVE orders require ALL of: TRADING_MODE=live, a request carrying TRADE_AUTH_TOKEN,
# liveMode:true from the client, and a durable KV (SUPABASE_SERVICE_ROLE_KEY).
# Anything less executes as PAPER. Default is paper.
TRADING_MODE=paper
# ≥16 random chars. Paste the same value in the app: Setup → Execution authorisation.
TRADE_AUTH_TOKEN=
# Optional separate token for maintenance routes (history build). Falls back to TRADE_AUTH_TOKEN.
ADMIN_TOKEN=
# Hard server-side limits (JSON, optional). Ceilings are enforced regardless: risk ≤2%, leverage ≤10×, daily loss ≤5%.
# RISK_LIMITS={"maxRiskPctPerTrade":1,"maxDailyLossPct":3,"maxLeverage":5,"maxConcurrentPositions":2,"maxTradesPerDay":5}

# ── Supabase (journal sync + historical edge engine) ─────────────────────────
SUPABASE_URL=https://mrhekpgvfcwfnzmipjis.supabase.co
SUPABASE_ANON_KEY=
# Service-role key: required for writing candles/backtests (hist_* tables), idempotency and daily counters.
# Keep it server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# Use "file" to keep history in ./data/history instead of Supabase (local dev)
# HISTORY_STORE=file

# ── AI desk note ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ── Push + cron ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=your@email.com
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/scan. Unset ⇒ cron route rejects everything.
CRON_SECRET=
